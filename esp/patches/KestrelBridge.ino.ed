void setup()
{
  // Level first, then direction: no low pulse on RA4 RESET / MD.
  gpio_set_level((gpio_num_t)GPIO_RST, 1);
  gpio_set_level((gpio_num_t)GPIO_BOOT, 1);
  gpio_set_direction((gpio_num_t)GPIO_RST, GPIO_MODE_OUTPUT);
  gpio_set_direction((gpio_num_t)GPIO_BOOT, GPIO_MODE_OUTPUT);
